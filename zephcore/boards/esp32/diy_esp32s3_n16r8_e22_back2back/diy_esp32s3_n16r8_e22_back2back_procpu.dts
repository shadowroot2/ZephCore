/* SPDX-License-Identifier: MIT */
/*
 * DIY ESP32-S3 N16R8 + E22-400M30S Back2Back.
 *
 * PSRAM is deliberately not enabled: GPIO46 is the LoRa NSS line.
 * Radio: SX1268, SPI2 SCK=9 MISO=11 MOSI=10, NSS=46, DIO1=14,
 * BUSY=13, RESET=12, TXEN=47, RXEN=48. DIO2-TXEN jumper is removed.
 */

/dts-v1/;

#include <espressif/esp32s3/esp32s3_wroom_n16.dtsi>
#include "diy_esp32s3_n16r8_e22_back2back-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/lora/sx126x.h>
#include <espressif/partitions_0x0_amp_16M.dtsi>

/ {
	model = "DIY ESP32-S3 N16R8 + E22-400M30S Back2Back";
	compatible = "diy,esp32s3-n16r8-e22-back2back";

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	aliases {
		led0 = &tx_led;
		lora0 = &lora0;
		sw0 = &user_button;
		watchdog0 = &wdt0;
	};

	leds {
		compatible = "gpio-leds";
		tx_led: tx_led {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "LoRa TX LED";
		};
	};

	buttons: buttons {
		compatible = "gpio-keys";
		user_button: user_button {
			gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "User Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&wdt0 { status = "okay"; };
&trng0 { status = "okay"; };
&usb_serial { status = "okay"; };

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";

	gnss: gnss-nmea-generic {
		compatible = "gnss-nmea-generic";
	};
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>; /* GPIO46 */

	lora0: modem@0 {
		/* The native SX126x driver registers SX1268 through the SX1262
		 * compatible; both use the same standalone HAL path. */
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <8000000>;
		reset-gpios = <&gpio0 12 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW)>;
		busy-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpio0 14 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		tx-enable-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>; /* GPIO47 */
		rx-enable-gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>; /* GPIO48 */
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <10>;
		startup-delay-ms = <10>;
		rx-boosted;
	};
};

&timer0 { status = "okay"; };
&timer1 { status = "okay"; };
&timer2 { status = "okay"; };
&timer3 { status = "okay"; };
&esp32_bt_hci { status = "okay"; };
&wifi { status = "okay"; };
